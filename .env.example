# Copy to .env and fill in locally. Never commit .env.

# LangSmith tracing (Milestone 3)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agent-autonomy-lab-synthetic

# Live runs call the model through LiteLLM, which reads OPENAI_API_KEY. If the
# key lives only in ../tau2-bench/.env, load both files instead of copying it:
#   uv run --env-file .env --env-file ../tau2-bench/.env python -m ...
OPENAI_API_KEY=your-openai-api-key

# τ-bench data. The installed tau2 package cannot find its data, so point
# this at the sibling clone's data/ directory; run results are written there.
TAU2_DATA_DIR=/absolute/path/to/tau2-bench/data
