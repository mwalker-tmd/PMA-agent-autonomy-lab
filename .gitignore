# --- Secrets and local configuration (never commit credentials) ---
.env
.env.*
!.env.example

# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# --- Generated simulation results and trace exports ---
# Commit only curated manifests and summaries, not raw dumps.
results/
reports/raw/
traces/
*.trace.json

# Replay cassettes: every model response of a recorded run. Each cassette's
# SHA-256 goes in a run manifest instead (reports/m3-traces/manifest.yaml).
cassettes/
*.cassette.json

# --- τ-bench output ---
# τ-bench writes under its own data directory (../tau2-bench/data by
# default), outside this repository. These patterns catch its output if
# TAU2_DATA_DIR or an absolute --save-to path points into this repository.
data/simulations/
*_simulation.json
logs/
*.log

# --- OS / editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
